# ══════════════════════════════════════════════════════════
#  Enterprise-as-Code — Environment Variables
#  Copy to .env and fill in your values.
# ══════════════════════════════════════════════════════════

# ── Supabase (Hard DB) ──
SUPABASE_URL=https://{{your_project}}.supabase.co
SUPABASE_SERVICE_ROLE_KEY={{your_service_role_key}}

# ── LLM Providers (The Spirit) ──
# CEO Agent — uses the heaviest reasoning model
CEO_MODEL_PROVIDER=anthropic          # anthropic | openai | google
CEO_MODEL_NAME=claude-sonnet-4-20250514

# Worker Agents — cost-optimized per department
WORKER_MODEL_PROVIDER=openai
WORKER_MODEL_NAME=gpt-4o

# Manager Subagents — surgical SOP editing
MANAGER_MODEL_PROVIDER=anthropic
MANAGER_MODEL_NAME=claude-sonnet-4-20250514

# API Keys
OPENAI_API_KEY={{your_openai_key}}
ANTHROPIC_API_KEY={{your_anthropic_key}}
GOOGLE_AI_API_KEY={{your_google_key}}

# ── Connectors / Nervous System ──
# Only enable the integrations your blueprint requires.

# Email
RESEND_API_KEY={{your_resend_key}}

# E-Commerce
SHOPIFY_STORE_URL={{your_store}}.myshopify.com
SHOPIFY_ADMIN_API_KEY={{your_shopify_key}}

# Advertising
GOOGLE_ADS_DEVELOPER_TOKEN={{your_google_ads_token}}
GOOGLE_ADS_CLIENT_ID={{your_client_id}}
GOOGLE_ADS_CLIENT_SECRET={{your_client_secret}}

# Payments
STRIPE_SECRET_KEY={{your_stripe_key}}

# Analytics
POSTHOG_API_KEY={{your_posthog_key}}
POSTHOG_HOST=https://app.posthog.com

# Version Control (for Soft DB evolution)
GITHUB_TOKEN={{your_github_pat}}
GITHUB_ORG={{your_org}}
GITHUB_REPO={{your_repo}}

# ── Runtime ──
LOG_LEVEL=INFO
MAX_REACT_ITERATIONS=10              # Micro-loop safety limit
WORKER_BUDGET_LIMIT_USD=50.00        # Per-session spend cap
CEO_BUDGET_LIMIT_USD=500.00          # Per-directive spend cap
