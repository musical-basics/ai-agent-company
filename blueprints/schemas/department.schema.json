{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Department Configuration",
  "description": "Schema for validating department definitions in swarm-compose.yml",
  "type": "object",
  "required": ["name", "description", "git_mind_directory", "agents", "manager", "tools_granted", "budget_allocation_usd"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_]+$",
      "description": "Snake_case department identifier"
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "git_mind_directory": {
      "type": "string",
      "pattern": "^minds/departments/"
    },
    "pgvector_namespace": {
      "type": "string",
      "pattern": "^ns_"
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "sop_file"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z_]+$" },
          "role": { "type": "string" },
          "model_provider": { "type": "string", "enum": ["openai", "anthropic", "google"] },
          "model_name": { "type": "string" },
          "sop_file": { "type": "string", "pattern": "\\.md$" }
        }
      }
    },
    "manager": {
      "type": "object",
      "required": ["model_provider", "model_name"],
      "properties": {
        "model_provider": { "type": "string" },
        "model_name": { "type": "string" }
      }
    },
    "tools_granted": {
      "type": "array",
      "items": { "type": "string" },
      "description": "RBAC-controlled list of API tools this department can access"
    },
    "budget_allocation_usd": {
      "type": "number",
      "minimum": 0
    }
  }
}
